{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "dist/src",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": [
    "src/content.ts",
    "src/popup.ts"
  ]
}
