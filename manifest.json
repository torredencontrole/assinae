{
  "manifest_version": 3,
  "name": "Assinae",
  "short_name": "Assinae",
  "version": "1.1.0",
  "description": "Adiciona uma assinatura personalizada às suas mensagens do WhatsApp Web.",
  "action": {
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
